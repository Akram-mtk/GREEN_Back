generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// FIXME: national_id infos
model Users {
  id         String   @id @default(uuid()) @db.Uuid
  first_name String
  last_name  String
  email      String   @unique @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  password   String   @db.VarChar(255)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(0)

  EntryLog     EntryLog[]
  Rfid_cards   Rfid_cards[]
  Subscription UserSubscription[]
  Ticket       Ticket[]
  orders       order[]
  orderItems   OrderItem[]
}

model EntryLog {
  id       String   @id @default(uuid()) @db.Uuid
  user_id  String   @db.Uuid
  event_id String   @db.Uuid
  date     DateTime @default(now())
  Event    Event    @relation(fields: [event_id], references: [id])
  Users    Users    @relation(fields: [user_id], references: [id])

  @@unique([user_id, event_id])
}

model Area {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  deletedAt DateTime?

  EventCapacityAllocation EventCapacityAllocation[]
  subscriptionPlans       SubscriptionPlan[]
}


model Rfid_cards {
  id          String     @id @default(uuid()) @db.Uuid
  owner_id    String?    @db.Uuid
  card_uid    String     @unique @db.VarChar(64)
  card_secret String     @unique @db.VarChar(64)
  claim_code  String?    @unique @db.VarChar(64)
  status      CardStatus @default(issued)
  created_at  DateTime   @default(now()) @db.Timestamptz(0)
  updated_at  DateTime   @updatedAt @db.Timestamptz(0)

  owner Users? @relation(fields: [owner_id], references: [id])
}

model Event {
  id                  String      @id @default(uuid()) @db.Uuid
  name                String
  open_at             DateTime
  close_at            DateTime
  start_at            DateTime
  home_team_id        String      @db.Uuid
  away_team_id        String      @db.Uuid
  published           Boolean     @default(false)
  home_ticket_type    TicketType
  away_ticket_type    TicketType
  deletedAt           DateTime?

  home_team Team @relation("HomeTeam", fields: [home_team_id], references: [id])
  away_team Team @relation("AwayTeam", fields: [away_team_id], references: [id])

  EntryLog                EntryLog[]
  EventCapacityAllocation EventCapacityAllocation[]
}

// NOTE: available_seats >= 0 enforced via raw SQL CHECK constraint
model EventCapacityAllocation {
  id              String @id @default(uuid()) @db.Uuid
  event_id        String @db.Uuid
  area_id         String @db.Uuid
  available_seats Int
  home_team_area  Boolean
  price           Decimal  @db.Decimal(10, 2)

  Area  Area  @relation(fields: [area_id], references: [id])
  Event Event @relation(fields: [event_id], references: [id])

  Ticket Ticket[]
  orders order[]

  @@unique([event_id, area_id])
}

// Warning: allocation_id already has event_id (event_id is redundent)
model Ticket {
  id               String  @id @default(uuid()) @db.Uuid
  allocation_id    String  @db.Uuid
  user_id          String? @db.Uuid
  used             Boolean @default(false)
  isMinor          Boolean @default(false)
  parent_ticket_id String? @db.Uuid
  first_name       String?
  last_name        String?
  qr_code          String?

  parent_ticket Ticket?  @relation("TicketMinors", fields: [parent_ticket_id], references: [id])
  minor_tickets Ticket[] @relation("TicketMinors")

  EventCapacityAllocation EventCapacityAllocation @relation(fields: [allocation_id], references: [id])
  Users                   Users?                  @relation(fields: [user_id], references: [id])
}

// NOTE: change companion name to attendance
model order {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  allocation_id String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(0)

  Users                   Users                   @relation(fields: [user_id], references: [id])
  EventCapacityAllocation EventCapacityAllocation @relation(fields: [allocation_id], references: [id])
  companions              OrderItem[]

}

model OrderItem {
  id                   String  @id @default(uuid()) @db.Uuid
  order_id             String  @db.Uuid
  isMinor              Boolean @default(false)
  user_id              String? @db.Uuid
  first_name           String?
  last_name            String?
  parent_order_item_id String? @db.Uuid

  order       order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  Users       Users?     @relation(fields: [user_id], references: [id])
  parent_item OrderItem? @relation("MinorParent", fields: [parent_order_item_id], references: [id])
  minor_items OrderItem[] @relation("MinorParent")
}

model Team {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique
  short_name String    @unique
  imageUrl   String
  deletedAt  DateTime?

  home_events Event[] @relation("HomeTeam")
  away_events Event[] @relation("AwayTeam")
}

model SubscriptionPlan {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  description        String
  price              Decimal  @db.Decimal(10, 2)
  number_of_entrance Int?
  area_id            String   @db.Uuid
  is_active          Boolean  @default(true)
  expires_at         DateTime @db.Timestamptz(0)

  area Area @relation(fields: [area_id], references: [id])

  userSubscriptions UserSubscription[]
}

// FIXME : can a user have two subs at the same time ?
// NOTE: entrance_left >= 0
model UserSubscription {
  id                   String @id @default(uuid()) @db.Uuid
  owner_id             String @db.Uuid
  subscription_plan_id String @db.Uuid
  entrance_left        Int?

  owner        Users            @relation(fields: [owner_id], references: [id])
  subscription SubscriptionPlan @relation(fields: [subscription_plan_id], references: [id])
}

model Advertisement {
  id          String @id @default(uuid()) @db.Uuid
  title       String
  description String
  imageUrl    String
  link        String
  order       Int
}

model ClubSettings {
  id              String   @id @default(uuid()) @db.Uuid
  club_name       String   @default("Mouloudia Club d'Alger")
  club_short_name String   @default("MCA")
  stadium_name    String   @default("Stade de Ali AMMAR Dit Ali La Pointe")
  email           String   @default("mouloudia@gmail.com")
  phone           String   @default("0000000000")
  facebook        String   @default("")
  instagram       String   @default("")
  created_at      DateTime @default(now()) @db.Timestamptz(0)
  updated_at      DateTime @updatedAt @db.Timestamptz(0)
}

enum CardStatus {
  issued
  active
  blocked
}

enum TicketType {
  rfid
  qrcode
}
